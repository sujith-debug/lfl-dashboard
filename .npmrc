# Resolve @foundry/* from GitHub Packages (private, restricted).
# Create a classic PAT with `read:packages` (and `write:packages` to publish).
# Then: export NODE_AUTH_TOKEN=<github_pat>
#
# GitHub Packages requires the npm scope to match the GitHub org/user that
# owns the package repo — publish from an org named `foundry`.
@foundry:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
