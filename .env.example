# Keycloak / NextAuth
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client
# Optional for public clients (PKCE)
# KEYCLOAK_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# OPA
OPA_URL=http://localhost:8181/v1/data/permission/app/allow
# Account string sent in OPA input.resource.account (often matches Keycloak client id)
OPA_ACCOUNT=app

# Public Keycloak hints for client UI (required for Keycloak SSO logout)
NEXT_PUBLIC_KEYCLOAK_URL=
NEXT_PUBLIC_KEYCLOAK_REALM=
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=

LOG_LEVEL=debug

# GitHub Packages auth for @foundry/* (do not commit real tokens).
# export NODE_AUTH_TOKEN=<github_pat_with_read_packages>

# OpenTelemetry (OTLP/HTTP)
OTEL_SERVICE_NAME=foundry-app
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------------------
# PostgreSQL (Prisma) — username/password only. No IAM auth. No RDS Proxy.
# Never pass DATABASE_URL as a Docker build-arg; inject at runtime (ECS SSM).
#
# Local (docker-compose.yml):
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry?schema=public
#
# RDS (TLS). Store the full URL in SSM as /{env}/{APP_NAME}/build/DATABASE_URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
# Optional CA bundle: append &sslrootcert=/path/to/rds-combined-ca-bundle.pem
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# BigQuery (@foundry/bigquery)
# Prefer BIGQUERY_SERVICE_ACCOUNT_JSON for local/dev secrets injected at runtime.
# GCP runtime can omit the JSON and use workload identity / ADC instead.
# When a project or service-account JSON is set, /api/health/ready probes BigQuery.
#
# BIGQUERY_DEFAULT_PROJECT=your-gcp-project
# BIGQUERY_LOCATION=asia-south1
# BIGQUERY_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}'
# Prefer single quotes around the JSON so Next.js does not over-escape it.
# Comma-separated allowlist (dataset.table, dataset.*, project.dataset.table):
# BQ_ALLOWED_DATASETS_TABLES=analytics.events,raw.*
# ---------------------------------------------------------------------------
