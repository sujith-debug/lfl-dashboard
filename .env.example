# Keycloak / NextAuth
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client
# Optional for public clients (PKCE)
# KEYCLOAK_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# OPA
OPA_URL=http://localhost:8181/v1/data/permission/app/allow
# Account string sent in OPA input.resource.account (often matches Keycloak client id)
OPA_ACCOUNT=app

# Public Keycloak hints for client UI (required for Keycloak SSO logout)
NEXT_PUBLIC_KEYCLOAK_URL=
NEXT_PUBLIC_KEYCLOAK_REALM=
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=

LOG_LEVEL=debug

# OpenTelemetry (OTLP/HTTP)
OTEL_SERVICE_NAME=foundry-app
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------------------
# PostgreSQL (Prisma) — username/password only. No IAM auth. No RDS Proxy.
# Never pass DATABASE_URL as a Docker build-arg; inject at runtime (ECS SSM).
#
# Local (docker-compose.yml; set POSTGRES_PORT and the URL port if 5432 is taken):
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry?schema=public
#
# RDS (TLS). Store the full URL in SSM as /{env}/lfl-dashboard/build/DATABASE_URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
# Optional CA bundle: append &sslrootcert=/path/to/rds-combined-ca-bundle.pem
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# BigQuery (@foundry/bigquery)
# Prefer BIGQUERY_SERVICE_ACCOUNT_JSON for local/dev secrets injected at runtime.
# GCP runtime can omit the JSON and use workload identity / ADC instead.
# When a project or service-account JSON is set, /api/health/ready probes BigQuery.
#
# BIGQUERY_DEFAULT_PROJECT=your-gcp-project
# BIGQUERY_LOCATION=asia-south1
# BIGQUERY_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}'
# Prefer single quotes around the JSON so Next.js does not over-escape it.
# Comma-separated allowlist (dataset.table, dataset.*, project.dataset.table):
# BQ_ALLOWED_DATASETS_TABLES=analytics.events,raw.*
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LFL dashboard (/lfl)
# "sample" (default): made-up demo data
# "bigquery": the feed queries run in BigQuery (settings above) on a schedule
#             and load into this app's Postgres, which the board reads
# "bigquery-live": the feed SQL run straight in BigQuery on each load (cached,
#             LFL_LIVE_CACHE_MINUTES, default 360: each query is billed);
#             no app database. Reads intermediary.ebo_all_data when
#             the service account may, else rebuilds those lines from
#             airbyte.shopify_orders (within ~0.1%); silver classic, staff and
#             stock show once their tables are readable (checked every 30 min)
# LFL_DATA_SOURCE=bigquery
# LFL_LIVE_CACHE_MINUTES=360
# Carpet areas for bigquery-live (CSV / XLSX with "Store Name", "Carpet Area"):
# LFL_CARPET_FILE='C:/path/to/Store Carpet Area.xlsx'
# Every table the feed SQL reads must be allowlisted when the allowlist is set:
# BQ_ALLOWED_DATASETS_TABLES=intermediary.ebo_all_data,airbyte.shopify_orders,givametabse.orders,givametabse.tangoeye_data,raw_postgres_giva_db.offline_stores,raw_postgres_giva_db.order_stores,raw_postgres_giva_db.offline_staff,raw_postgres_giva_db.mto_orders_new,airbyte.shopify_products,airbyte.shopify_product_variants,guts.inventory_daily_snapshot
# LFL_SYNC_DAYS=7                  # days re-pulled each run (late corrections)
# LFL_SYNC_INTERVAL_MINUTES=360    # in-app schedule (>= 15); leave unset to use only the endpoint
# LFL_SYNC_TOKEN=                  # 24+ chars; enables POST /api/v1/lfl/sync for an external scheduler
# "Ask the data" chat. Unset = the button is hidden.
# Claude (preferred): sees the view and runs read-only SQL on the tables in
# BQ_ALLOWED_DATASETS_TABLES (in BigQuery, like the feeds).
# ANTHROPIC_API_KEY=
# LFL_ASK_MODEL=claude-opus-5-5
# Or any OpenAI-compatible /chat/completions endpoint (view numbers only, no SQL):
# LFL_ASK_PROVIDER=openai
# LFL_ASK_URL=https://litellm.example.internal/v1
# LFL_ASK_API_KEY=
# LFL_ASK_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------

# Local only: skip Keycloak under `npm run dev` (ignored by production builds).
# DEV_AUTH_BYPASS=true
