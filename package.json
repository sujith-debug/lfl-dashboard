{
  "name": "foundry-app",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry Next.js template — clone and customize for a new team project",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --require ./scripts/mock-server-only.cjs --import tsx --test src/**/*.test.ts",
    "foundry:local": "node scripts/switch-foundry-packages.mjs local",
    "foundry:release": "node scripts/switch-foundry-packages.mjs release",
    "foundry:status": "node scripts/switch-foundry-packages.mjs status",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "foundryPackages": {
    "releaseRepo": "GIVA-Jewellery/foundry-npm",
    "packageVersions": {
      "@foundry/api-client": "0.0.2",
      "@foundry/api-core": "0.0.2",
      "@foundry/auth-next": "0.0.2",
      "@foundry/bigquery": "0.0.1",
      "@foundry/http-next": "0.0.2",
      "@foundry/logger": "0.0.2",
      "@foundry/opa-client": "0.0.2",
      "@foundry/prisma": "0.0.2"
    },
    "releaseCacheDirectory": ".foundry-release",
    "localDirectory": "../../foundry-npm/packages"
  },
  "dependencies": {
    "@foundry/api-client": "file:.foundry-release/foundry-api-client-0.0.2.tgz",
    "@foundry/api-core": "file:.foundry-release/foundry-api-core-0.0.2.tgz",
    "@foundry/auth-next": "file:.foundry-release/foundry-auth-next-0.0.2.tgz",
    "@foundry/bigquery": "file:.foundry-release/foundry-bigquery-0.0.1.tgz",
    "@foundry/http-next": "file:.foundry-release/foundry-http-next-0.0.2.tgz",
    "@foundry/logger": "file:.foundry-release/foundry-logger-0.0.2.tgz",
    "@foundry/opa-client": "file:.foundry-release/foundry-opa-client-0.0.2.tgz",
    "@foundry/prisma": "file:.foundry-release/foundry-prisma-0.0.2.tgz",
    "@prisma/client": "^6.5.0",
    "next": "^14.0.0",
    "next-auth": "^4.24.5",
    "prisma": "^6.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.2.0"
  },
  "overrides": {
    "@foundry/api-client": "file:.foundry-release/foundry-api-client-0.0.2.tgz",
    "@foundry/api-core": "file:.foundry-release/foundry-api-core-0.0.2.tgz",
    "@foundry/auth-next": "file:.foundry-release/foundry-auth-next-0.0.2.tgz",
    "@foundry/bigquery": {
      ".": "file:.foundry-release/foundry-bigquery-0.0.1.tgz",
      "@foundry/logger": "file:.foundry-release/foundry-logger-0.0.1.tgz"
    },
    "@foundry/http-next": "file:.foundry-release/foundry-http-next-0.0.2.tgz",
    "@foundry/logger": "file:.foundry-release/foundry-logger-0.0.2.tgz",
    "@foundry/opa-client": "file:.foundry-release/foundry-opa-client-0.0.2.tgz",
    "@foundry/prisma": "file:.foundry-release/foundry-prisma-0.0.2.tgz"
  }
}
