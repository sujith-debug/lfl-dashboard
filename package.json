{
  "name": "foundry-app",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry Next.js template — clone and customize for a new team project",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --require ./scripts/mock-server-only.cjs --import tsx --test src/**/*.test.ts",
    "foundry:local": "node scripts/switch-foundry-packages.mjs local",
    "foundry:github": "node scripts/switch-foundry-packages.mjs github",
    "foundry:status": "node scripts/switch-foundry-packages.mjs status",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "foundryPackages": {
    "githubVersion": "^0.1.0",
    "localDirectory": "../../foundry-npm/packages"
  },
  "dependencies": {
    "@foundry/api-client": "file:../../foundry-npm/packages/api-client",
    "@foundry/api-core": "file:../../foundry-npm/packages/api-core",
    "@foundry/auth-next": "file:../../foundry-npm/packages/auth-next",
    "@foundry/http-next": "file:../../foundry-npm/packages/http-next",
    "@foundry/logger": "file:../../foundry-npm/packages/logger",
    "@foundry/opa-client": "file:../../foundry-npm/packages/opa-client",
    "@foundry/prisma": "file:../../foundry-npm/packages/prisma",
    "@prisma/client": "^6.5.0",
    "next": "^14.0.0",
    "next-auth": "^4.24.5",
    "prisma": "^6.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.2.0"
  }
}
